{
  "name": "orincard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/cloud/**'",
    "test:unit": "vitest run tests/setup.test.ts tests/unit/document.test.ts tests/unit/fonts.test.ts",
    "test:cloud": "vitest run tests/cloud",
    "test:planning": "node scripts/check-planning.mjs && node --test scripts/check-planning.test.mjs",
    "trigger:deploy:preview": "trigger deploy --env preview",
    "trigger:deploy:prod": "trigger deploy --env prod"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@trigger.dev/sdk": "4.5.16",
    "jszip": "3.10.1",
    "next": "16.3.4",
    "playwright": "1.57.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@trigger.dev/build": "4.5.16",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.0",
    "trigger.dev": "4.5.16",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

# Documentation only. Empty credentials; never paste live secrets into Git.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
DEEPSEEK_API_KEY=
AI_TEXT_MODEL=deepseek-v4-pro
# B06 图片生成使用；B05 转写已改用豆包。
APIMART_API_KEY=
# 豆包录音文件识别模型 2.0；音频临时签名 URL 仅供供应商拉取。
VOLCENGINE_SPEECH_API_KEY=
AI_TRANSCRIBE_MODEL=volc.seedasr.auc
PEXELS_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
# 授权图库。免费额度即可，注册地址 https://www.pexels.com/api/
PEXELS_API_KEY=
AI_MONTHLY_BUDGET_USD=10
USER_JOB_CONCURRENCY=1
EXPORT_CONCURRENCY=2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# readStripeBillingConfig 按 VERCEL_ENV 选前缀：production 用 STRIPE_LIVE_*，其余一律 STRIPE_TEST_*。
# 本仓库只配测试态；STRIPE_LIVE_SECRET_KEY 存在就会让 T088 发布守卫直接失败。
# 密钥必须是 sk_test_ 前缀。价格映射的键是 public.billing_plan_key 枚举值（free / pro / creator），
# 值是 Stripe 的 price_ id，例如 {"pro":"price_…","creator":"price_…"}。
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_MONTHLY_PRICES_JSON=
STRIPE_TEST_YEARLY_PRICES_JSON=
STRIPE_TEST_PROMOTION_CODES_JSON=
RESEND_API_KEY=
MAIL_FROM=
BILLING_LIVE_ENABLED=false
AFFILIATE_PAYOUTS_ENABLED=false

# --- 真实云测试 ---
# 云测试默认关闭，因为它们会消耗真实额度。置为 1 才运行；缺少所需变量时它们会显式失败
# 并点名缺哪一个，绝不会静默跳过后当作通过。
ORINCARD_RUN_AUTH_CLOUD=
ORINCARD_RUN_AUTH_RECOVERY_CLOUD=
ORINCARD_RUN_OWNERSHIP_CLOUD=
ORINCARD_RUN_PROJECTS_CLOUD=
ORINCARD_RUN_TEXT_SOURCE_CLOUD=
ORINCARD_RUN_GENERATION_CLOUD=
ORINCARD_RUN_GENERATION_JOB_CLOUD=
ORINCARD_RUN_UPLOADS_CLOUD=
ORINCARD_RUN_URL_SOURCE_CLOUD=
ORINCARD_RUN_AI_IMAGE_CLOUD=
# PDF 与 PPTX 不需要凭据，只需要本机 poppler 与 tesseract：
# brew install poppler tesseract tesseract-lang
ORINCARD_RUN_PDF_CLOUD=
ORINCARD_RUN_SLIDES_CLOUD=
# 视频来源需要本机 ffmpeg（brew install ffmpeg）与 macOS 的 say 合成一段真实语音，
# 并且要用 VOLCENGINE_SPEECH_API_KEY + AI_TRANSCRIBE_MODEL 做一次真实转录，不接受静音顶替。
ORINCARD_RUN_VIDEO_CLOUD=
# Playwright 端到端，固定单 worker
ORINCARD_RUN_WALKING_SKELETON_E2E=
ORINCARD_RUN_TEXT_GENERATION_E2E=
ORINCARD_CAPTURE_VISUALS=
# 开发库里两个真实测试账号。跨账号隔离用例需要第二个账号
ORINCARD_AUTH_TEST_EMAIL=
ORINCARD_AUTH_TEST_PASSWORD=
ORINCARD_AUTH_OTHER_EMAIL=
ORINCARD_AUTH_OTHER_PASSWORD=
# 一个稳定的公开 https 页面，供 URL 来源抓取用例作为探针
ORINCARD_URL_SOURCE_PROBE_URL=

# T073 支付生命周期验收。置为 1 才会去 Stripe 测试环境真实建 Checkout / Portal 会话并在跑完删掉
# 测试 customer；测试本身拒绝 sk_live_ 前缀的密钥。ACCEPTANCE_PLAN_KEY 指定用哪个档位下单，
# 取值必须出现在 STRIPE_TEST_MONTHLY_PRICES_JSON 的键里。
RUN_STRIPE_SANDBOX_LIFECYCLE=
STRIPE_TEST_ACCEPTANCE_PLAN_KEY=

# CI-only credentials belong in GitHub/Vercel secrets, not this file.
